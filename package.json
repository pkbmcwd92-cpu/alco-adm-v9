{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:snapshot": "tsx scripts/testSnapshotRegression.ts",
    "test:curriculum": "tsx scripts/testCurriculumMaster.ts",
    "test:school": "tsx scripts/testSchoolArchitecture.ts",
    "test:workflow": "tsx scripts/testWorkflowDependencyRegression.ts",
    "test:kktp": "tsx scripts/testKKTPRegression.ts",
    "test:calendar": "tsx scripts/testCalendarJpRegression.ts",
    "test:audit8": "tsx scripts/testAuditNo8LearningPlanRegression.ts",
    "test:audit9a": "tsx scripts/testAuditNo9AAssessmentMasterRegression.ts",
    "test:audit9b": "tsx scripts/testAuditNo9BAssessmentPackageRegression.ts",
    "test:audit9c:schema": "tsx scripts/testAuditNo9CSchemaFoundationRegression.ts",
    "test:audit9c2:generation-spec": "tsx scripts/testAuditNo9C2GenerationSpecRegression.ts",
    "test:audit9c3:generation-plan": "tsx scripts/testAuditNo9C3GenerationPlanRegression.ts",
    "test:audit9c4:ai-generator": "tsx scripts/testAuditNo9C4AIGeneratorRegression.ts",
    "test:audit9c5:validation": "tsx scripts/testAuditNo9C5AssessmentValidationRegression.ts",
    "test:audit9c6:regeneration": "tsx scripts/testAuditNo9C6AssessmentRegenerationRegression.ts",
    "test:audit9c8:export": "tsx scripts/testAuditNo9C8DocumentExportRegression.ts",
    "test:regulatory2026": "tsx scripts/testAudit2026RegulatoryCompatibility.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
